+    const uint32_t copyLen = (dstOfs < dstEnd) ? zstdgpu_MinU32(dstEnd - dstOfs, seq.mlen) : 0u;
+    ZSTDGPU_BRANCH if (seq.offs >= zstdgpu_MinU32(laneCount, seq.mlen))
